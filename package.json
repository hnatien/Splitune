{
  "name": "splitune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "docker compose -f infra/docker-compose.yml up -d && turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . && turbo run lint",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "contracts:gen": "node scripts/contracts.mjs gen",
    "contracts:check": "node scripts/contracts.mjs check",
    "secrets:scan": "gitleaks git --redact --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
