{
  "name": "splitune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "docker compose -f infra/docker-compose.yml up -d && turbo run dev",
    "dev:all": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:remote-workers": "node scripts/dev.mjs --remote-workers",
    "dev:stack-workers": "node scripts/dev.mjs --stack-workers",
    "dev:remote-stack": "node scripts/dev.mjs --remote-stack",
    "build": "turbo run build",
    "lint": "biome check . && node scripts/check-db-access.mjs && node scripts/check-ui-tokens.mjs && turbo run lint",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --dir scripts",
    "e2e": "turbo run e2e",
    "contracts:gen": "node scripts/contracts.mjs gen",
    "contracts:check": "node scripts/contracts.mjs check",
    "db:check": "pnpm --filter @splitune/db check",
    "db:migrate": "pnpm --filter @splitune/db migrate",
    "db:roles": "pnpm --filter @splitune/db roles",
    "db:studio": "pnpm --filter @splitune/db studio",
    "seed": "pnpm --filter @splitune/db seed",
    "workers": "node scripts/workers.mjs",
    "workers:prod": "node scripts/dev.mjs --prod-workers",
    "examples:build": "node --env-file-if-exists=.env apps/api/scripts/examples/build.ts",
    "secrets:scan": "gitleaks git --redact --verbose",
    "audit:deps": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "railway": "3.16.0",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
