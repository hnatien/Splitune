[Unit]
Description=Splitune ML Worker (PyTorch CUDA on WSL2)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Splitune/services/ml
Environment=ML_MODE=local
Environment=SPLITUNE_ENV_FILE=%h/Splitune/.env.worker
ExecStart=%h/.cargo/bin/uv run --frozen splitune-ml-worker
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=1500

[Install]
WantedBy=default.target
