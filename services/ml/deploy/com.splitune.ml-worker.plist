<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the Splitune ML worker on the owner's Mac (25-personal-mode.md §5-6), against
  production.

  Installed with `pnpm workers install`, which fills in __REPO__ (the checkout) and __USER_HOME__
  ($HOME); run `uv sync --project services/ml/islands/torch` and
  `uv sync --project services/ml/islands/onnx-cpu` first.

  Settings come from __REPO__/.env.worker only (SPLITUNE_ENV_FILE; never .env): ML_DATABASE_URL
  with the ml_worker role, bucket credentials, FFMPEG_BIN_DIR. Nothing secret belongs in this
  file. On SIGTERM the worker stops claiming and finishes running jobs within ExitTimeOut;
  anything cut off is re-queued by the stale-lock sweep (120 s).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.splitune.ml-worker</string>
  <key>WorkingDirectory</key>
  <string>__REPO__/services/ml</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--frozen</string>
    <string>splitune-ml-worker</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ML_MODE</key>
    <string>local</string>
    <key>SPLITUNE_ENV_FILE</key>
    <string>__REPO__/.env.worker</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>180</integer>
  <!-- Normal scheduling priority (not App Nap-throttled background work). -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/Splitune/ml-worker.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/Splitune/ml-worker.log</string>
</dict>
</plist>
