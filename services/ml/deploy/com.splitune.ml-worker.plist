<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the Splitune ML worker on the owner's Mac (25-personal-mode.md §5-6).

  Install (replace __REPO__ with the absolute checkout path, __USER_HOME__ with $HOME):
    uv sync --project services/ml/islands/torch && uv sync --project services/ml/islands/onnx-cpu
    sed -e "s#__REPO__#$PWD#g" -e "s#__USER_HOME__#$HOME#g" \
      services/ml/deploy/com.splitune.ml-worker.plist > ~/Library/LaunchAgents/com.splitune.ml-worker.plist
    mkdir -p ~/Library/Logs/Splitune
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.splitune.ml-worker.plist
  Restart:  launchctl kickstart -k gui/$(id -u)/com.splitune.ml-worker
  Remove:   launchctl bootout gui/$(id -u)/com.splitune.ml-worker

  Settings come from __REPO__/.env and .env.worker (ML_DATABASE_URL with the ml_worker role,
  bucket credentials, FFMPEG_BIN_DIR); nothing secret belongs in this file. On SIGTERM the worker
  stops claiming and finishes running jobs within ExitTimeOut; anything cut off is re-queued by
  the stale-lock sweep (120 s).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.splitune.ml-worker</string>
  <key>WorkingDirectory</key>
  <string>__REPO__/services/ml</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--frozen</string>
    <string>splitune-ml-worker</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ML_MODE</key>
    <string>local</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>180</integer>
  <!-- Normal scheduling priority (not App Nap-throttled background work). -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/Splitune/ml-worker.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/Splitune/ml-worker.log</string>
</dict>
</plist>
