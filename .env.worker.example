# The Mac's production workers (`pnpm workers install`; 25-personal-mode.md §6): copy to
# .env.worker (git-ignored, `chmod 600`) and fill in. Both launchd agents read this file only —
# never .env — and nothing else on the Mac reads it, so local development and E2E workers can't
# reach production. Every value below is a fake placeholder.

LOG_LEVEL=info
CACHE_SCOPE=global

# --- Railway Postgres over its public TCP proxy (TLS) ------------------------------------------
# <proxy-host>:<port> from Railway's DATABASE_PUBLIC_URL; passwords from `pnpm db:roles`.
# Railway's server certificate is self-signed for an internal name, so the connection is
# encrypted without verifying it: sslmode=no-verify (node-postgres) / sslmode=require (psycopg).
# The keepalives make a socket left dead by sleep or a network change fail within ~1 min instead
# of hanging (the node worker sets its own in code).
ML_DATABASE_URL=postgres://ml_worker:<password>@<proxy-host>:<port>/railway?sslmode=require&keepalives_idle=30&keepalives_interval=10&keepalives_count=3
NODE_WORKER_DATABASE_URL=postgres://node_worker:<password>@<proxy-host>:<port>/railway?sslmode=no-verify
NODE_WORKER_MAINTENANCE_DATABASE_URL=postgres://maintenance:<password>@<proxy-host>:<port>/railway?sslmode=no-verify

# --- Cloudflare R2 (token splitune-mac-workers: Item Read + Write on splitune-media only) ------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=splitune-media
S3_ACCESS_KEY_ID=<token id>
S3_SECRET_ACCESS_KEY=<sha-256 hex of the token value>
S3_FORCE_PATH_STYLE=false

# --- Shared with Railway's app ------------------------------------------------------------------
# The same value as the app's ANALYTICS_SALT (account deletion removes events by that hash).
ANALYTICS_SALT=<same as app>

# --- ML worker (ML_MODE=local comes from the launchd agent) ----------------------------------------
FFMPEG_BIN_DIR=/opt/homebrew/opt/ffmpeg@8/bin
# Kept apart from local development's cache; the weights are shared.
ML_CACHE_DIR=~/.cache/splitune/ml-production
ML_MODELS_DIR=~/.cache/splitune/models
ML_WORKER_ID=ml-mac
ML_MPS_SLOTS=1
ML_CPU_SLOTS=2
ML_TORCH_DEVICE=auto

# --- Node worker ---------------------------------------------------------------------------------
NODE_WORKER_ID=node-mac
LIFECYCLE_STEMS_INACTIVE_DAYS=180
LIFECYCLE_EXPIRE_RAW_UPLOADS=false
LIFECYCLE_NIGHTLY_AT=03:30
# Nightly pg_dump (as maintenance) to an external disk; restore: docs in 19 §6. Empty = off.
PG_DUMP_DIR=/Volumes/<disk>/Splitune/pg_dump
PG_DUMP_KEEP=14
PG_DUMP_BIN=/opt/homebrew/bin/pg_dump

# Daily digest email (needs SMTP); empty DIGEST_EMAIL_TO = off.
DIGEST_EMAIL_TO=
DIGEST_AT=08:00
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Splitune <no-reply@example.com>"
