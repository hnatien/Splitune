# Local development environment. `pnpm run setup` copies this file to .env (git-ignored).
# Every value here is a fake, local-only placeholder matching infra/docker-compose.yml.
# Real values for Railway live in Railway variables and are never committed.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Public origin of the app (web + API under /v1). Railway uses its *.up.railway.app domain.
APP_URL=http://localhost:3000
# Port of the app server (web + API; `pnpm --filter @splitune/web start` or the standalone API's
# `dev:standalone`); `vite dev` always uses 3000. Railway sets PORT itself.
PORT=3000
LOG_LEVEL=info
# Comma-separated origins allowed by CORS and Better Auth's origin check; empty = APP_URL only.
CORS_ORIGINS=
# true behind Railway's proxy: the client address (per-IP rate limits) is the last
# X-Forwarded-For hop. Keep false when the API is reached directly.
TRUST_PROXY=false
# analyses.pipeline_version (part of the analysis idempotency key); empty = the Railway deploy's
# commit (RAILWAY_GIT_COMMIT_SHA), else "dev".
PIPELINE_VERSION=

# --- Database (Postgres 18 from docker compose) -------------------------------
DATABASE_URL=postgres://splitune:splitune-dev-password@localhost:5432/splitune
# Used by the Mac workers to reach Railway Postgres over the TCP proxy (restricted ml_worker role).
# Locally it points at the same compose database.
DATABASE_PUBLIC_URL=postgres://splitune:splitune-dev-password@localhost:5432/splitune
# Passwords `pnpm db:roles` sets on the restricted roles created by the migrations; an empty value
# leaves that role NOLOGIN. The API needs none (withUser() switches to role `app` per
# transaction); the Mac workers log in as ml_worker / node_worker, e.g.
# postgres://ml_worker:<password>@<railway-tcp-proxy>/railway, and sweepers as maintenance.
DB_APP_PASSWORD=
DB_ML_WORKER_PASSWORD=dev-only-ml-worker-password
DB_NODE_WORKER_PASSWORD=dev-only-node-worker-password
DB_MAINTENANCE_PASSWORD=dev-only-maintenance-password

# --- Object storage (SeaweedFS S3 gateway locally, Cloudflare R2 in production)
# Production: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_FORCE_PATH_STYLE=false, keys from a bucket-scoped R2 API token; CORS in infra/r2/cors.json.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=splitune-media
S3_ACCESS_KEY_ID=splitune-dev-access-key
S3_SECRET_ACCESS_KEY=splitune-dev-secret-key-not-a-real-secret
# SeaweedFS needs path-style addressing (http://host/bucket/key).
S3_FORCE_PATH_STYLE=true

# --- Auth (Better Auth) --------------------------------------------------------
# At least 32 characters; generate a real one for Railway with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in; leave empty to use magic links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Mailpit locally: UI at http://localhost:8025) ----------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Splitune <no-reply@splitune.localhost>"

# --- Billing (personal mode: mock only, no real payments) ---------------------
BILLING_PROVIDER=mock
# HMAC key the mock checkout uses to sign events sent to /internal/billing/webhook.
BILLING_WEBHOOK_SECRET=dev-only-billing-webhook-secret
# Prices shown on /pricing and the mock checkout, in minor units of BILLING_CURRENCY.
BILLING_CURRENCY=USD
BILLING_PRICE_MONTHLY_MINOR=999
BILLING_PRICE_YEARLY_MINOR=7999
# true enables POST /internal/dev/clock (advance the billing clock to test renewals, expiry,
# reminders and allowance resets). Local development only; never in production.
ENABLE_DEV_CLOCK=false

# --- Analysis pipeline ---------------------------------------------------------
# global (personal mode default) | user (dormant commercial profile)
CACHE_SCOPE=global
# mock: stages return golden fixtures from packages/contracts/fixtures (no GPU needed)
# local: native Python ML worker on the Mac (PyTorch MPS)
ML_MODE=mock
# HMAC key for stage callbacks (X-Splitune-Signature).
SPLITUNE_CALLBACK_SECRET=dev-only-callback-secret

# --- ML worker (services/ml, `uv run splitune-ml-worker`) ------------------------
# Connection as the restricted ml_worker role (after `pnpm db:roles`). Falls back to
# DATABASE_PUBLIC_URL when empty; on the Mac for Railway, use the TCP proxy URL with ml_worker.
ML_DATABASE_URL=postgres://ml_worker:dev-only-ml-worker-password@localhost:5432/splitune
# Directory with ffmpeg/ffprobe 8.1; empty = PATH. Homebrew: /opt/homebrew/opt/ffmpeg@8/bin
FFMPEG_BIN_DIR=
# Decoded FLAC intermediates, raw separated stems and job scratch space (local disk only).
ML_CACHE_DIR=~/.cache/splitune/ml
# Separation weights (audio-separator/, fetched with the torch island's
# `audio-separator --download_model_only -m <filename> --model_file_dir <dir>/audio-separator`) and
# the tagger's ONNX (panns/, scripts/export_tagger.py), checked against compliance/register.
ML_MODELS_DIR=~/.cache/splitune/models
# Per-instrument separation model map; empty = services/ml/config/separation.personal.yaml.
ML_SEPARATION_CONFIG=
# Overrides of services/ml/config/{notes,chords}.personal.yaml (eval runs). Read from the process
# environment (export them): the worker does not read them from this file. Empty = unset.
ML_NOTES_CONFIG=
ML_CHORDS_CONFIG=
# node for music-core's key estimator; empty = PATH.
NODE_BIN=
# Unique per running worker; default ml-<hostname>.
ML_WORKER_ID=
# Concurrency (25-personal-mode.md §5) and torch device: auto | mps | cpu.
ML_MPS_SLOTS=1
ML_CPU_SLOTS=2
ML_TORCH_DEVICE=auto

# --- Node worker (apps/node-worker, `pnpm --filter @splitune/node-worker dev`) ----------
# Connection as the restricted node_worker role (after `pnpm db:roles`). Falls back to
# DATABASE_PUBLIC_URL when empty; on the Mac for Railway, use the TCP proxy URL with node_worker.
NODE_WORKER_DATABASE_URL=postgres://node_worker:dev-only-node-worker-password@localhost:5432/splitune
# Unique per running worker; default node-<hostname>.
NODE_WORKER_ID=
# recommended_view thresholds; empty = services/ml/config/views.yaml.
NODE_WORKER_VIEWS_CONFIG=
