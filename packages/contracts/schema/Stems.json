{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Stems",
  "$defs": {
    "Stems": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "artefact": {
          "type": "string",
          "const": "stems"
        },
        "artefact_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "audio_hash": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "sample_rate": {
          "type": "number",
          "const": 44100
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelRef"
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "stems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stem"
          }
        },
        "alignment_offset_samples": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mix_gain_db": {
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "artefact",
        "artefact_version",
        "analysis_id",
        "user_id",
        "audio_hash",
        "sample_rate",
        "duration_s",
        "models",
        "params",
        "created_at",
        "stems",
        "alignment_offset_samples",
        "mix_gain_db"
      ]
    },
    "SchemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "weights_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "provider": {
          "type": "string",
          "enum": [
            "self_hosted",
            "vendor"
          ]
        },
        "register_tier": {
          "type": "string",
          "enum": [
            "green",
            "amber",
            "red"
          ]
        }
      },
      "required": [
        "model_id",
        "version",
        "weights_sha256",
        "provider",
        "register_tier"
      ]
    },
    "Stem": {
      "type": "object",
      "properties": {
        "stem_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "isolated",
            "mix_minus",
            "residual"
          ]
        },
        "instrument": {
          "$ref": "#/$defs/Instrument"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StemFile"
          }
        },
        "loudness_lufs": {
          "type": "number"
        },
        "gain_to_unity_db": {
          "type": "number"
        },
        "energy_ratio_to_mix": {
          "type": "number",
          "minimum": 0
        },
        "quality_hint": {
          "type": "string",
          "enum": [
            "good",
            "rough"
          ]
        },
        "empty": {
          "type": "boolean"
        }
      },
      "required": [
        "stem_id",
        "kind",
        "provider",
        "files",
        "loudness_lufs",
        "gain_to_unity_db",
        "energy_ratio_to_mix",
        "quality_hint",
        "empty"
      ]
    },
    "Instrument": {
      "type": "string",
      "enum": [
        "guitar",
        "bass",
        "piano",
        "drums",
        "vocals",
        "other"
      ]
    },
    "StemFile": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "enum": [
            "opus",
            "aac"
          ]
        },
        "container": {
          "type": "string",
          "enum": [
            "webm",
            "mp4"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bitrate_kbps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "codec",
        "container",
        "path",
        "bitrate_kbps"
      ]
    }
  },
  "title": "Stems"
}
