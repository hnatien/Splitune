{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Summary",
  "$defs": {
    "Summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "per_instrument": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstrumentSummary"
          }
        },
        "chords_confidence_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rough_stems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "analysis_id",
        "per_instrument",
        "chords_confidence_mean",
        "rough_stems"
      ]
    },
    "SchemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "InstrumentSummary": {
      "type": "object",
      "properties": {
        "instrument": {
          "$ref": "#/$defs/Instrument"
        },
        "note_confidence_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fraction_low_conf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recommended_view": {
          "$ref": "#/$defs/RecommendedView"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewReason"
          }
        }
      },
      "required": [
        "instrument",
        "note_confidence_mean",
        "fraction_low_conf",
        "recommended_view",
        "reasons"
      ]
    },
    "Instrument": {
      "type": "string",
      "enum": [
        "guitar",
        "bass",
        "piano",
        "drums",
        "vocals",
        "other"
      ]
    },
    "RecommendedView": {
      "type": "string",
      "enum": [
        "tab",
        "notation",
        "roll",
        "drum_grid",
        "f0",
        "chords_only"
      ]
    },
    "ViewReason": {
      "type": "string",
      "enum": [
        "notes_unavailable",
        "notation_not_supported",
        "rough_stem_low_conf",
        "low_confidence"
      ]
    }
  },
  "title": "Summary"
}
