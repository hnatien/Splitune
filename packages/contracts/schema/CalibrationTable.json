{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CalibrationTable",
  "$defs": {
    "CalibrationTable": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "isotonic",
            "identity"
          ]
        },
        "knots": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "bands": {
          "type": "object",
          "properties": {
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "high",
            "medium"
          ]
        },
        "fitted_on": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "version",
        "method",
        "knots",
        "bands"
      ]
    }
  },
  "title": "CalibrationTable"
}
