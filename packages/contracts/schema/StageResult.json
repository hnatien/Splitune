{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/StageResult",
  "$defs": {
    "StageResult": {
      "type": "object",
      "properties": {
        "analysis_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "status": {
          "type": "string",
          "enum": [
            "done",
            "failed",
            "fallback"
          ]
        },
        "artefacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtefactWritten"
          }
        },
        "model_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelRef"
          }
        },
        "metrics": {
          "$ref": "#/$defs/StageMetrics"
        },
        "error_code": {
          "$ref": "#/$defs/MachineCode"
        },
        "fallback_reason": {
          "$ref": "#/$defs/MachineCode"
        }
      },
      "required": [
        "analysis_id",
        "stage",
        "status",
        "artefacts",
        "model_refs",
        "metrics"
      ]
    },
    "StageName": {
      "type": "string",
      "enum": [
        "url_import",
        "decode",
        "beats",
        "tag",
        "separate",
        "stem_post",
        "chords",
        "notes.guitar",
        "notes.bass",
        "notes.piano",
        "notes.drums",
        "notes.vocals",
        "notes.other",
        "f0.vocals",
        "sections",
        "lyrics",
        "finalize"
      ]
    },
    "ArtefactWritten": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtefactKind"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "key": {
          "$ref": "#/$defs/ObjectKey"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "version",
        "key",
        "sha256",
        "bytes"
      ]
    },
    "ArtefactKind": {
      "type": "string",
      "pattern": "^(manifest|probe|beats|tags|separation|presence|stems|sections|chords|summary|(notes|tab|render)\\.(guitar|bass|piano|drums|vocals|other))$"
    },
    "ObjectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "weights_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "provider": {
          "type": "string",
          "enum": [
            "self_hosted",
            "vendor"
          ]
        },
        "register_tier": {
          "type": "string",
          "enum": [
            "green",
            "amber",
            "red"
          ]
        }
      },
      "required": [
        "model_id",
        "version",
        "weights_sha256",
        "provider",
        "register_tier"
      ]
    },
    "StageMetrics": {
      "type": "object",
      "properties": {
        "gpu_s": {
          "type": "number",
          "minimum": 0
        },
        "cpu_s": {
          "type": "number",
          "minimum": 0
        },
        "peak_vram_mb": {
          "type": "number",
          "minimum": 0
        },
        "cold_start_s": {
          "type": "number",
          "minimum": 0
        },
        "audio_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "MachineCode": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.]*$"
    }
  },
  "title": "StageResult"
}
