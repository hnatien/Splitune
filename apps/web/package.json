{
  "name": "@splitune/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web app (TanStack Start PWA) \u2014 docs/implementation/10-web-app-architecture.md",
  "type": "module",
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang --outdir ./app/paraglide --emit-ts-declarations && tsr generate",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=../../.env .output/server/index.mjs",
    "typecheck": "pnpm run generate && tsc -p .",
    "test": "pnpm run generate && vitest run --project unit",
    "test:stories": "pnpm run generate && vitest run --project storybook",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "pnpm run generate && storybook build -o storybook-static",
    "lighthouse": "CHROME_PATH=$(node -e \"console.log(require('playwright').chromium.executablePath())\") lhci autorun",
    "budget": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@orpc/client": "1.15.7",
    "@orpc/contract": "1.15.7",
    "@orpc/openapi-client": "1.15.7",
    "@orpc/tanstack-query": "1.15.7",
    "@splitune/api": "workspace:*",
    "@splitune/db": "workspace:*",
    "@splitune/storage": "workspace:*",
    "@splitune/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@uppy/core": "6.3.0",
    "better-auth": "1.7.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hash-wasm": "4.12.0",
    "hono": "4.13.13",
    "lucide-react": "1.60.0",
    "mediabunny": "1.62.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
