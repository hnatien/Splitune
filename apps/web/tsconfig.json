    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@vitest/browser-playwright"],
    "paths": {
      "@/*": ["./app/*"]
    }
  },
  "include": [
