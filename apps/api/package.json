{
  "name": "@splitune/api",
  "version": "0.0.0",
  "private": true,
  "description": "API (Hono + oRPC + Better Auth) — docs/implementation/04-api-contract.md",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev:standalone": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "openapi:check": "node scripts/openapi.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@orpc/contract": "1.15.7",
    "@orpc/json-schema": "1.15.7",
    "@orpc/openapi": "1.15.7",
    "@orpc/server": "1.15.7",
    "@orpc/zod": "1.15.7",
    "@splitune/analytics": "workspace:*",
    "@splitune/contracts": "workspace:*",
    "@splitune/db": "workspace:*",
    "@splitune/storage": "workspace:*",
    "better-auth": "1.7.11",
    "hono": "4.13.13",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@readme/openapi-parser": "9.1.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
